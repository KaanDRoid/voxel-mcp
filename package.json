{
  "name": "magicvoxel-mcp",
  "version": "1.3.0",
  "description": "Local MCP server for voxel modeling, MagicaVoxel scenes, previews, and asset conversion.",
  "main": "dist/index.js",
  "bin": { "magicvoxel-mcp": "dist/index.js" },
  "files": ["dist", "client-config", "docs", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=22.2" },
  "repository": { "type": "git", "url": "git+https://github.com/KaanDRoid/voxel-mcp.git" },
  "bugs": { "url": "https://github.com/KaanDRoid/voxel-mcp/issues" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm audit",
    "prepack": "npm run build"
  },
  "keywords": ["mcp", "magicavoxel", "voxel", "model-context-protocol"],
  "author": "KaanDRoid",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "gifenc": "^1.0.3",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
